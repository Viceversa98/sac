# Local placeholders only. Cloud SQL's real DB_PASSWORD lives in Secret Manager.
# There is no GEMINI_API_KEY. Agent Platform uses the Cloud Run service account.

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=true
FIRESTORE_COLLECTION=audit_events
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL_LITE=gemini-3.1-flash-lite

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sampay
DB_PASSWORD=sampay_local
DB_NAME=sampay
# Cloud Run: unix socket from the Cloud SQL volume, e.g. /cloudsql/PROJECT:asia-southeast2:sampay
DB_SOCKET=

DEMO_MODE=1
PORT=8080
WEB_ORIGIN=http://localhost:5173
